<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow/glow effect -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#40000000" />
            <size
                android:width="60dp"
                android:height="60dp" />
        </shape>
    </item>
    <!-- Main button with gradient -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="0dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#60A5FA"
                android:centerColor="#3B82F6"
                android:endColor="#2563EB" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>
    <!-- Inner highlight for depth -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="28dp"
                android:centerX="0.3"
                android:centerY="0.3"
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />
            <size
                android:width="52dp"
                android:height="52dp" />
        </shape>
    </item>
</layer-list>
