<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow for recording state -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#60EF4444" />
            <size
                android:width="64dp"
                android:height="64dp" />
        </shape>
    </item>
    <!-- Shadow -->
    <item
        android:bottom="0dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#40000000" />
            <size
                android:width="60dp"
                android:height="60dp" />
        </shape>
    </item>
    <!-- Main button with red gradient -->
    <item
        android:bottom="2dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#F87171"
                android:centerColor="#EF4444"
                android:endColor="#DC2626" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>
    <!-- Inner highlight -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="26dp"
                android:centerX="0.3"
                android:centerY="0.3"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
</layer-list>
