<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="16dp"
    android:paddingBottom="20dp"
    android:background="@drawable/ime_background">

    <!-- Status text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to speak"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Mic button and cancel button in a row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Cancel button (shown when recording) -->
        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:paddingHorizontal="16dp"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#FF6B6B"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/ime_switch_button_bg"
            android:visibility="gone" />

        <!-- Mic button -->
        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/overlay_button_background"
            android:src="@drawable/ic_mic"
            android:contentDescription="Record"
            android:scaleType="center"
            android:elevation="4dp" />

    </LinearLayout>

    <!-- Hint text - changes based on state -->
    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Double-tap to clear"
        android:textColor="#4DFFFFFF"
        android:textSize="10sp" />

    <!-- Switch keyboard button -->
    <TextView
        android:id="@+id/switchButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="Switch keyboard"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:background="@drawable/ime_switch_button_bg"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
